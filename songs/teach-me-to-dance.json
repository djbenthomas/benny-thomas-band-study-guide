        { "segments": [ { "chord": "D", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Start on the one, or lead with the second" },
        { "segments": [ { "chord": "G.", "text": "" } ] },
        { "plain": "Something like that" },
        { "blank": true },
        { "plain": "I missed the first lesson" },
        { "segments": [ { "chord": "E", "text": " " }, { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Never had a dance floor show me no luck" },
        { "segments": [ { "chord": "D", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Now look at you in them cowgirl boots" },
        { "segments": [ { "chord": "G", "text": "" } ] },
        { "plain": "Probably could teach me a step or two" },
        { "segments": [ { "chord": "E", "text": " " }, { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Show me a life that's a little more fun" }
      ]
    },
    {
      "name": "Pre-Chorus",
      "type": "pre-chorus",
      "start": 36,
      "end": null,
      "lines": [
        { "segments": [ { "chord": "B", "text": "" } ] },
        { "plain": "Too much time on my hands" },
        { "segments": [ { "chord": "A", "text": "" } ] },
        { "plain": "Getting stuck in my head" },
        { "segments": [ { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "I don't get out much anymore" },
        { "segments": [ { "chord": "B", "text": "" } ] },
        { "plain": "These walls just keep me in" },
        { "segments": [ { "chord": "A", "text": "" } ] },
        { "plain": "With all my favorite sins" },
        { "segments": [ { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Got my bags packed on the porch" }
      ]
    },
    {
