      "start": 52,
      "end": null,
      "lines": [
        { "segments": [ { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Get me out of feeling down" },
        { "segments": [ { "chord": "D", "text": " " }, { "chord": "B", "text": "" } ] },
        { "plain": "Hit me up, let's go downtown" },
        { "segments": [ { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "My two left feet need a second chance" },
        { "segments": [ { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Get me over the no's and can'ts" },
        { "segments": [ { "chord": "D.", "text": " " }, { "chord": "B", "text": "" } ] },
        { "plain": "Get me drunk, whatever it takes" },
        { "segments": [ { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Wake me up, dust me off" },
        { "segments": [ { "chord": "D", "text": "" } ] },
        { "plain": "Teach me to dance" }
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "start": 72,
      "end": null,
      "lines": [
        { "segments": [ { "chord": "D", "text": "" } ] },
        { "plain": "It ain't that hard, no, it ain't that new" },
        { "segments": [ { "chord": "G", "text": "" } ] },
        { "plain": "A couple more shots, a couple more brews" },
        { "segments": [ { "chord": "E", "text": " " }, { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Had a heart broke, I'm a broken man" },
        { "segments": [ { "chord": "D", "text": "" } ] },
        { "plain": "Fell down hard, got up again" },
        { "segments": [ { "chord": "G", "text": "" } ] },
        { "plain": "I could choose to blame the past" },
        { "segments": [ { "chord": "E", "text": " " }, { "chord": "G", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "But it all could change, I could learn to dance" },
        { "segments": [ { "chord": "B", "text": " " }, { "chord": "A", "text": "" } ] },
        { "plain": "Maybe this time I could do-si-do" }
      ]
    },
