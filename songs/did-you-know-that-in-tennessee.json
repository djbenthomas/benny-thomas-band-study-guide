      "lines": [
        { "segments": [ { "chord": "A", "text": "" } ] },
        { "plain": "We moved to town" },
        { "plain": "We were the perfect team" },
        { "segments": [ { "chord": "D", "text": "" } ] },
        { "plain": "You got to work" },
        { "plain": "And I would play and sing" },
        { "segments": [ { "chord": "A", "text": "" } ] },
        { "plain": "Those Broadway bars" },
        { "plain": "Can wear you thin" },
        { "segments": [ { "chord": "D", "text": "" } ] },
        { "plain": "I guess drinking became a thing" }
      ]
    },
    {
