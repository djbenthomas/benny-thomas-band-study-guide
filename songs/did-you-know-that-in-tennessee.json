        { "segments": [ { "chord": "F#m", "text": " " }, { "chord": "C#m", "text": "" } ] },
        { "plain": "Did you know I'd never change?" },
        { "segments": [ { "chord": "D", "text": " " }, { "chord": "C#", "text": " " }, { "chord": "B", "text": " " }, { "chord": "A", "text": " " }, { "chord": "F#", "text": "" } ] },
