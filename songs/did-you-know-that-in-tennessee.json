        { "plain": "Did you know" },
        { "segments": [ { "chord": "E", "text": "" } ] },
        { "plain": "You were falling out of love?" },
        { "segments": [ { "chord": "B", "text": "" } ] },
        { "plain": "Did you know" },
        { "segments": [ { "chord": "E", "text": "" } ] },
